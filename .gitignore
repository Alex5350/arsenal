# macOS
.DS_Store

# Harness-local wiring created by scripts/bootstrap.sh.
# These are per-developer machines, not project state. If you later want to
# commit shared harness config (for example .claude/settings.json for team
# hooks), negate the specific path here.
.claude/
.codex/
.opencode/skills/

# Credentials never belong in git. Copy docs/templates/work-item.example.env
# to .env and fill it locally.
.env
.env.*
!.env.example
