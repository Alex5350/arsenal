# Copy to .env (gitignored) and fill in. Consumed by scripts/work-item.sh.
# Never commit the filled copy; see docs/standards/security.md.

# Which backend to dispatch to: gh | jira | ado
WORK_BACKEND=gh

# --- GitHub Issues backend ---
GH_REPO=owner/repo

# --- Jira backend ---
JIRA_HOST=yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_TOKEN=replace-with-api-token
JIRA_PROJECT=PROJ

# --- Azure DevOps backend ---
ADO_ORG=https://dev.azure.com/yourcompany
ADO_PROJECT=YourProject
# Optional; defaults to the project root area
# ADO_AREA_PATH=YourProject\\Team A
