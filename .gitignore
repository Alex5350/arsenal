# Some machines carry a global gitignore that excludes CLAUDE.md (local agent
# scratch files). Here it is the Claude Code adapter and must be committed.
!CLAUDE.md

# macOS
.DS_Store

# Harness-local state (settings, history) is per-developer and untracked.
# Repo content under these directories: the shared agents (.claude/agents),
# the Claude Code plugin settings (.claude/settings.json), and the Codex
# agent TOMLs that scripts/sync.sh generates (.codex/agents). The skills
# library lives in .agents/skills, which needs no rule here. The bare
# directory negations are required because machines with a global ignore
# that excludes these directories outright would otherwise block the
# child re-inclusions below.
!.claude/
.claude/*
!.claude/settings.json
!.claude/agents
!.codex/
.codex/*
!.codex/agents

# Credentials never belong in git. Copy docs/templates/work-item.example.env
# to .env and fill it locally.
.env
.env.*
!.env.example
